s://x.com/sundarpichai/status/2103209164072010051","id":"2103209164072010051","text":"Can our TPUs survive and operate in space? Well, we're going to find out.\n\nProject Suncatcher is hitching a ride aboard @SpaceX's Transporter-18 mission, testing a prototype satellite built in partnership with @planet\n\nOne small step for TPUs....","raw_text":{"text":"Can our TPUs survive and operate in space? Well, we're going to find out.\n\nProject Suncatcher is hitching a ride aboard @SpaceX's Transporter-18 mission, testing a prototype satellite built in partnership with @planet\n\nOne small step for TPUs.... https://t.co/FuZoj7c0Hl","display_text_range":[0,246],"facets":[{"type":"mention","indices":[120,127],"original":"SpaceX","id":"34743251"},{"type":"mention","indices":[210,217],"original":"planet","id":"17663776"},{"type":"media","indices":[247,270],"id":"2103208798299332608","display":"pic.x.com/FuZoj7c0Hl","original":"https://t.co/FuZoj7c0Hl","replacement":"https://x.com/sundarpichai/status/2103209164072010051/video/1"}]},"author":{"screen_name":"sundarpichai","url":"https://x.com/sundarpichai","id":"14130366","followers":11644196,"following":198,"likes":1159,"media_count":385,"name":"Sundar Pichai","description":"CEO, Google and Alphabet","raw_description":{"text":"CEO, Google and Alphabet","facets":[]},"location":"","banner_url":"","avatar_url":"https://pbs.twimg.com/profile_images/2051799620062429184/AL8CoAUG_200x200.jpg","joined":"Wed Mar 12 05:51:53 +0000 2008","protected":false,"website":null,"verification":{"verified":true,"verified_at":null,"type":"individual"},"avatar_color":null},"replies":384,"retweets":969,"likes":9008,"bookmarks":909,"quotes":265,"created_at":"Thu Sep 24 19:45:15 +0000 2026","created_timestamp":1790279115,"possibly_sensitive":false,"views":1400737,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":null,"replying_to_status":null,"media":{"all":[{"id":"2103208798299332608","url":"https://video.twimg.com/amplify_video/210