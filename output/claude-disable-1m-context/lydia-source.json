.mp4?tag=29","bitrate":256000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2108623848971366400/vid/avc1/1046x360/Vga0GQSQp2iUtN9d.mp4?tag=29","bitrate":832000,"content_type":"video/mp4"},{"url":"https://video.twimg.com/amplify_video/2108623848971366400/vid/avc1/1920x660/v6tK9K5GeS2gwKGn.mp4?tag=29","bitrate":2176000,"content_type":"video/mp4"}]}]},"quote":{"url":"https://x.com/wholyv/status/2108393422658908495","id":"2108393422658908495","text":"holy fuck. so auto compact basically loads last 1M tokens into context by default on claude?\n\nand here i thought they were summarising and reducing the context loads. \n\nno wonder people used to burn anywhere from 2%-15% 5h limits simply for auto compacting their sessions.","raw_text":{"text":"holy fuck. so auto compact basically loads last 1M tokens into context by default on claude?\n\nand here i thought they were summarising and reducing the context loads. \n\nno wonder people used to burn anywhere from 2%-15% 5h limits simply for auto compacting their sessions.","display_text_range":[0,272],"facets":[]},"author":{"screen_name":"wholyv","url":"https://x.com/wholyv","id":"1975471361846812672","followers":3786,"following":539,"likes":12961,"media_count":918,"name":"Lxyv","description":"I speak AI and experiment with things. making new benchmarks","raw_description":{"text":"I speak AI and experiment with things. making new benchmarks","facets":[]},"location":"","banner_url":"https://pbs.twimg.com/profile_banners/1975471361846812672/1779530843","avatar_url":"https://pbs.twimg.com/profile_images/2068351283040526336/NbtVEpxn_200x200.jpg","joined":"Tue Oct 07 08:01:02 +0000 2025","protected":false,"website":null,"verification":{"verified":true,"verified_at":null,"type":"individual"},"avatar_color":null},"replies":42,"retweets":11,"likes":1061,"bookmarks":971,"quotes":6,"created_at":"Fri Oct 09 03:05:38 +0000 2026","created_timestamp":1791515138,"views":221931,"is_note_tweet":false,"community_note"